+            print(f"Voice WAV: OK (mono PCM16, sample rate {sample_rate})")
+        except Exception as exc:
+            print(f"FAIL voice WAV: {exc}")
+            failures += 1
+    else:
+        print("Voice WAV: not checked (pass --voice)")
